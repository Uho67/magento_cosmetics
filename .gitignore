# ── Magento application ───────────────────────────────────────────────────────
/vendor/
/generated/
/var/
/pub/static/
/pub/media/*
!/pub/media/.htaccess

# env.php contains DB creds, crypt key, etc. — never commit
/app/etc/env.php

# config.php is deployment config (enabled modules list) — DO commit
!/app/etc/config.php

# ── Auth / secrets ────────────────────────────────────────────────────────────
/auth.json
/.env.prod
/.env.local

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build artifacts ───────────────────────────────────────────────────────────
/pub/static/frontend/
/pub/static/adminhtml/
/pub/static/base/

# ── Composer cache (not the lock file — lock file should be committed) ────────
# DO commit composer.json and composer.lock

# Production secrets — copy to .env.prod and fill in real values.
# .env.prod is gitignored and must NEVER be committed.
#
# Usage:
#   docker compose -f /srv/legal/repo/deploy/docker-compose.prod.yml \
#                  --env-file /srv/legal/.env.prod up -d

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=example.com

# ── Application paths (on the VPS host filesystem) ────────────────────────────
# APP_ROOT points to the currently active build.
# scripts/deploy.sh manages this directory via mv (atomic swap).
APP_ROOT=/srv/legal/builds/current
SHARED_MEDIA=/srv/legal/shared/media
SHARED_LOGS=/srv/legal/shared/logs

# ── Database ──────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=change_me_root
DB_NAME=magento
DB_USER=magento
DB_PASSWORD=change_me_db

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=magento
RABBITMQ_PASSWORD=change_me_mq

# ── Magento admin (used only during first-time setup:install) ─────────────────
ADMIN_USER=enrole
ADMIN_PASSWORD=change_me_admin
ADMIN_EMAIL=admin@example.com

# ── Magento crypt key ─────────────────────────────────────────────────────────
# Generated by setup:install. Copy from app/etc/env.php after first deploy.
# Keep a secure backup — losing this key makes encrypted data unrecoverable.
CRYPT_KEY=

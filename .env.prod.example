# Production secrets — copy to .env.prod and fill in real values.
# .env.prod is gitignored and must NEVER be committed.
#
# Usage:
#   docker compose -f deploy/docker-compose.prod.yml --env-file .env.prod up -d

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=example.com

# ── Database ──────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=change_me_root
DB_NAME=magento
DB_USER=magento
DB_PASSWORD=change_me_db

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=magento
RABBITMQ_PASSWORD=change_me_mq

# ── Magento admin (used only during first-time setup:install) ─────────────────
ADMIN_USER=enrole
ADMIN_PASSWORD=change_me_admin
ADMIN_EMAIL=admin@example.com

# ── Magento crypt key (generated by setup:install; copy from env.php) ─────────
# Leave blank on first deploy — setup:install will generate one.
# After first deploy, paste the value from app/etc/env.php here for reference.
CRYPT_KEY=

# ── Traefik Let's Encrypt (set in deploy/traefik/traefik.yml) ─────────────────
# ACME_EMAIL is in traefik.yml, not here, because it is not a secret.

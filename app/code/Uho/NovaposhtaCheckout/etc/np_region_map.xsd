<?xml version="1.0"?>
<!--
/**
 * Maps Nova Poshta `settlement_area_description` values onto Magento
 * `directory_country_region.code` ISO codes.
 *
 * Never map onto region_id: those are install-specific auto-increment values.
 */
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <xs:simpleType name="regionCodeType">
        <xs:annotation>
            <xs:documentation>ISO 3166-2:UA subdivision code, e.g. UA-32.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="UA-[0-9]{2}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="areaNameType">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="255"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="cityRefType">
        <xs:annotation>
            <xs:documentation>perspective_novaposhta_catalog_cities.ref GUID.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="areaType">
        <xs:attribute name="name" type="areaNameType" use="required"/>
        <xs:attribute name="regionCode" type="regionCodeType" use="required"/>
    </xs:complexType>

    <xs:complexType name="cityOverrideType">
        <xs:attribute name="cityRef" type="cityRefType" use="required"/>
        <xs:attribute name="regionCode" type="regionCodeType" use="required"/>
    </xs:complexType>

    <xs:complexType name="areasType">
        <xs:sequence>
            <xs:element name="area" type="areaType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="cityOverridesType">
        <xs:sequence>
            <xs:element name="cityOverride" type="cityOverrideType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="config">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="areas" type="areasType"/>
                <xs:element name="cityOverrides" type="cityOverridesType"/>
            </xs:choice>
        </xs:complexType>
    </xs:element>

</xs:schema>

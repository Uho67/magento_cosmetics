<?xml version="1.0"?>
<!--
Global scope: order placement can be triggered from frontend, adminhtml (order creation) or the
webapi, so the fail-closed guard in §6 B3 must fire in all of them.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_before">
        <observer name="uho_novaposhta_assert_composed_address"
                  instance="Uho\NovaposhtaCheckout\Observer\SalesModelServiceQuoteSubmitBefore"/>
    </event>
</config>

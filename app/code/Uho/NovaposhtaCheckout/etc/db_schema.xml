                comment="Nova Poshta Warehouse Name Snapshot"/>
        <column xsi:type="varchar" name="uho_np_warehouse_site_key" length="8" nullable="true"
                comment="Nova Poshta Warehouse Site Key"/>
        <index referenceId="SALES_ORDER_ADDRESS_UHO_NP_WAREHOUSE_REF" indexType="btree">
            <column name="uho_np_warehouse_ref"/>
        </index>
    </table>
</schema>

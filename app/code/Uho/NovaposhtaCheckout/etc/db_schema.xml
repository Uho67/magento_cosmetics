                comment="Nova Poshta City Ref"/>
        <column xsi:type="varchar" name="uho_np_city_name" length="255" nullable="true"
                comment="Nova Poshta City Name Snapshot"/>
        <column xsi:type="varchar" name="uho_np_warehouse_ref" length="36" nullable="true"
                comment="Nova Poshta Warehouse Ref"/>
        <column xsi:type="varchar" name="uho_np_warehouse_name" length="255" nullable="true"

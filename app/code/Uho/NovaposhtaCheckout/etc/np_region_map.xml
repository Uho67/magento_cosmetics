    <cityOverrides>
        <!-- Київ: warehouses carry settlement_area_description "Київська", which
             would otherwise route all 7904 of them to Kyivska oblast (UA-32). -->
        <cityOverride cityRef="8d5a980d-391c-11dd-90d9-001a92567626" regionCode="UA-30"/>
    </cityOverrides>
</config>

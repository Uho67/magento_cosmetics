<?xml version="1.0"?>
<!--
/**
 * Nova Poshta oblast (`settlement_area_description`) -> Magento
 * `directory_country_region.code`.
 *
 * 23 area values are present in perspective_novaposhta_catalog_warehouse.
 * UA-09 (Luhanska), UA-40 (Sevastopol) and UA-43 (Krym) carry no Nova Poshta
 * data but are mapped anyway so a future data sync cannot fail closed.
 */
-->
<config xsi:noNamespaceSchemaLocation="urn:magento:module:Uho_NovaposhtaCheckout:etc/np_region_map.xsd"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <areas>
        <area name="Київська" regionCode="UA-32"/>
        <area name="Львівська" regionCode="UA-46"/>
        <area name="Дніпропетровська" regionCode="UA-12"/>
        <area name="Одеська" regionCode="UA-51"/>
        <area name="Харківська" regionCode="UA-63"/>
        <area name="Вінницька" regionCode="UA-05"/>
        <area name="Полтавська" regionCode="UA-53"/>
        <area name="Хмельницька" regionCode="UA-68"/>
        <area name="Черкаська" regionCode="UA-71"/>
        <area name="Рівненська" regionCode="UA-56"/>
        <area name="Івано-Франківська" regionCode="UA-26"/>
        <area name="Тернопільська" regionCode="UA-61"/>
        <area name="Житомирська" regionCode="UA-18"/>
        <area name="Волинська" regionCode="UA-07"/>
        <area name="Миколаївська" regionCode="UA-48"/>
